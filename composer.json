{
    "name": "midsonlajeanty/php-natcash-sdk",
    "type": "library",
    "description": "Minimum SDK to process payment with Natcom Natcash Payment Gateway",
    "keywords": [
        "natcash",
        "payment"
    ],
    "license": "MIT",
    "homepage": "https://github.com/midsonlajeanty/php-natcash-sdk",
    "support": {
        "issues": "https://github.com/midsonlajeanty/php-natcash-sdk/issues",
        "source": "https://github.com/midsonlajeanty/php-natcash-sdk"
    },
    "authors": [
        {
            "name": "Louis Midson LAJEANTY",
            "email": "midsonlajeanty@proton.me"
        }
    ],
    "scripts": {
        "demo": "php example/cli.php",
        "serve": "php -S localhost:1234 -t example",
        "refactor": "./vendor/bin/rector process",
        "lint": "./vendor/bin/pint",
        "test:unit": "./vendor/bin/pest",
        "test:refactor": "./vendor/bin/rector process --dry-run",
        "test:lint": "./vendor/bin/pint --test",
        "test:types": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "test": [
            "@test:unit",
            "@test:refactor",
            "@test:lint",
            "@test:types"
        ]
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "Mds\\Natcash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "illuminate/support": "Enables the auto-discovered Laravel service provider and the Natcash facade (Laravel 12 and 13)."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Mds\\Natcash\\Laravel\\NatcashServiceProvider"
            ],
            "aliases": {
                "Natcash": "Mds\\Natcash\\Laravel\\Facades\\Natcash"
            }
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.3"
    }
}
